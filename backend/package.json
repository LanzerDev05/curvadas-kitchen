{
  "name": "curvadas-backend",
  "version": "1.0.0",
  "description": "Curvada's Kitchen Standalone REST & WebSocket Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:stg": "cross-env APP_ENV=stg tsx src/server.ts",
    "dev:prod": "cross-env APP_ENV=prod tsx src/server.ts",
    "build": "tsc",
    "start": "cross-env APP_ENV=prod node dist/server.js",
    "start:stg": "cross-env APP_ENV=stg node dist/server.js",
    "start:dev": "cross-env APP_ENV=dev node dist/server.js",
    "migrate:json-to-db": "tsx src/scripts/migrate-json-to-db.ts",
    "seed": "tsx src/scripts/seed-initial-data.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "@types/ws": "^8.5.13",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
