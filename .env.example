# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# DATABASE SYNC OPTIONS (Choose ONE or BOTH to sync Localhost <-> Live Deploy):
# ==============================================================================

# OPTION 1: Direct Proxy to Live Deployed Server (Simplest & Instant Sync)
# VITE_BACKEND_URL="https://curvadas-kitchen.onrender.com"

# OPTION 2: Shared Upstash Redis Cloud Database
UPSTASH_REDIS_REST_URL="YOUR_UPSTASH_REST_URL_HERE"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REST_TOKEN_HERE"
